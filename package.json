{
  "name": "atoms-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:e2e": "playwright test tests/e2e --workers=1 --reporter=line",
    "build:preview-runtime": "node scripts/build-preview-runtime.mjs",
    "predev": "npm run build:preview-runtime",
    "prebuild": "npm run build:preview-runtime"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.19",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "wrangler": "4.148.0"
  }
}
