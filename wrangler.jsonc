{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atoms-demo",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "APP_DATA", "class_name": "ProjectDataStore" }] },
  "migrations": [{ "tag": "app-data-v1", "new_sqlite_classes": ["ProjectDataStore"] }],
  "worker_loaders": [{ "binding": "BACKEND_LOADER" }],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    { "name": "APP_DATA_LIMIT", "namespace_id": "2061128", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "GENERATION_LIMIT",
      "namespace_id": "2061127",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
